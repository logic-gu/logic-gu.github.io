{% comment %}
    Print a pretty date (somehow)
    input:
        start-date[=date] (date)   end-date of event
        date              (date)   date of event
        end-date [=date]  (date)   start-date of event
        format          (string)   format for date
    output:
        start-date [-> end-date]
        NB: (hours omitted in case of start-date)
{% endcomment %}
{% assign d_fmt = '%Y-%m-%d' %}
{% assign t_fmt = 'T%H:%M:%S' %}
{% assign event = include.event %}

{% assign start = "" %}
{% assign end = "" %}
{% include snippets/get_date.liquid event=event %}
{% assign start-day = start | date: d_fmt %}
{% assign end-day = end | date: d_fmt %}
{% if start-day == end-day %}
    {% assign is_multiday = false %}
{% else %}
    {% assign is_multiday = true %}
{% endif %}

{% if is_multiday %}
    {% assign omit_time = true %}
{% else %}
    {% assign omit_time = false %}
{% endif %}

{% assign format = '%A, %-d %B %Y' %}
{% unless omit_time %}{% assign format = format | append: ' at %H:%M' %}{% endunless %}

{% comment %}
  Create icon objects
{% endcomment %}
{% capture calendar %}<i class="fa-solid fa-calendar fa-sm">&nbsp;</i>{% endcapture %}
{% capture arrow %}<i class="fa-solid fa-long-arrow-right fa-sm"></i>{% endcapture %}

<time datetime="{{ start }}">{{ calendar }}{{ start | date: format }}</time>
{%- if is_multiday %} 
    &nbsp;{{ arrow }}&nbsp; 
    <time datetime="{{ end }}">{{ calendar }}{{ end | date: format }}</time>
{% endif -%}